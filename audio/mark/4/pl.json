ezgłowiu.","words":[[0,0.18],[0.18,0.415],[0.415,0.707],[0.707,0.831],[0.831,1.123],[1.123,1.47],[1.47,1.65],[1.65,2.223]]},{"sid":"storm","bi":6,"file":"63.mp3","dur":5.527,"text":"Zbudzili Go i powiedzieli do Niego: «Nauczycielu, nic Cię to nie obchodzi, że giniemy?»","words":[[0,0.47],[0.47,0.633],[0.633,0.746],[0.746,1.369],[1.369,1.532],[1.532,1.849],[2.066,2.964],[3.182,3.412],[3.412,3.642],[3.642,3.818],[3.818,4.048],[4.048,4.551],[4.77,4.983],[4.983,5.527]]},{"sid":"storm","bi":7,"file":"64.mp3","dur":5.042,"text":"On wstał, rozkazał wichrowi i rzekł do jeziora: «Milcz, ucisz się!».","words":[[0,0.324],[0.324,0.951],[1.168,1.697],[1.697,2.226],[2.226,2.353],[2.353,2.71],[2.71,2.894],[2.894,3.365],[3.583,3.896],[3.992,4.618],[4.618,5.042]]},{"sid":"storm","bi":8,"file":"65.mp3","dur":2.872,"text":"Wicher się uspokoił i nastała głęboka cisza.","words":[[0,0.455],[0.455,0.721],[0.721,1.303],[1.303,1.442],[1.442,1.961],[1.961,2.48],[2.48,2.872]]},{"sid":"storm","bi":9,"file":"66.mp3","dur":4.918,"text":"Wtedy rzekł do nich: «Czemu tak bojaźliwi jesteście? Jakże wam brak wiary?»","words":[[0,0.384],[0.384,0.767],[0.767,0.965],[0.965,1.287],[1.554,1.926],[1.926,2.179],[2.179,2.792],[2.792,3.405],[3.633,3.998],[3.998,4.246],[4.246,4.552],[4.552,4.918]]},{"sid":"storm","bi":10,"file":"67.mp3","dur":6.914,"text":"Oni zlękli się bardzo i mówili jeden do drugiego: «Kim właściwie On jest, że nawet wicher i jezioro są Mu posłuszne?»","words":[[0,0.219],[0.219,0.595],[0.595,0.814],[0.814,1.19],[1.19,1.305],[1.305,1.681],[1.681,2.005],[2.005,2.172],[2.172,2.652],[2.865,3.103],[3.103,3.681],[3.681,3.862],[3.862,4.157],[4.264,4.459],[4.459,4.835],[4.835,5.273],[5.273,5.407],[5.407,5.905],[5.905,6.1],[6.1,6.294],[6.294,6.914]]}]}